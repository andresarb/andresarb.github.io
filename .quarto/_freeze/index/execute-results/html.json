    "markdown": "---\ntitle: \"\"\ncss: index-styles.css\ntoc: false\nexecute:\n  echo: false\n  warning: false\n  message: false\n---\n\n```{=html}\n<!-- Slick carousel CSS -->\n<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.css\"/>\n<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick-theme.min.css\"/>\n\n<!-- Banner image with overlay -->\n<div class=\"banner\">\n  <img src=\"images/banner_Gavilea_araucana.webp\" alt=\"banner\">\n  <div class=\"banner-overlay\">\n    <p>Plant Evolutionary Biologist</p>\n  </div>\n</div>\n\n<div class=\"page-content\">\n<!-- Home layout: about + spacer + carousel -->\n<div class=\"home-layout\">\n  <div class=\"about-section\">\n    <div class=\"about-photo\">\n      <img src=\"images/profile_photo.jpg\" alt=\"Andres Romero Bravo\">\n    </div>\n    <div class=\"about-text\">\n      <p>Hi! I am a plant evolutionary biologist working on floral evolution,\n      plant–pollinator interactions, and plant adaptation to environmental change.</p>\n      <p>\n        <a href=\"about.html\">More about me</a> ·\n        <a href=\"research.html\">My research</a> ·\n        <a href=\"cv.html\">CV</a> ·\n        <a href=\"publications.html\">Publications</a>\n      </p>\n      <div class=\"social-links\">\n        <a href=\"mailto:andres.romero_bravo@biol.lu.se\" title=\"Email\" aria-label=\"Email\"><i class=\"bi bi-envelope\"></i></a>\n        <a href=\"https://portal.research.lu.se/en/persons/andr%C3%A9s-romero-bravo/\" target=\"_blank\" title=\"Lund University profile\" aria-label=\"Lund University profile\"><i class=\"bi bi-person-badge\"></i></a>\n        <a href=\"https://linkedin.com/in/aromerobravo\" target=\"_blank\" title=\"LinkedIn\" aria-label=\"LinkedIn\"><i class=\"bi bi-linkedin\"></i></a>\n        <a href=\"https://bsky.app/profile/a-romerobravo.bsky.social\" target=\"_blank\" title=\"Bluesky\" aria-label=\"Bluesky\"><i class=\"bi bi-bluesky\"></i></a>\n        <a href=\"https://spain.inaturalist.org/people/andresrb\" target=\"_blank\" title=\"iNaturalist\" aria-label=\"iNaturalist\"><i class=\"bi bi-leaf\"></i></a>\n        <a href=\"https://www.peakbagger.com/climber/ClimbListC.aspx?cid=53158&u=m&j=-1&y=9999&oid=&oname=&sort=ascentdated\" target=\"_blank\" title=\"Peakbagger\" aria-label=\"Peakbagger\"><i class=\"bi bi-triangle-fill\"></i></a>\n        <a href=\"https://github.com/andresarb\" target=\"_blank\" title=\"GitHub\" aria-label=\"GitHub\"><i class=\"bi bi-github\"></i></a>\n      </div>\n    </div>\n  </div>\n\n  <!-- Spacer -->\n  <div class=\"home-spacer\"></div>\n\n  <!-- Carousel -->\n  <div class=\"home-carousel\">\n```\n\n<div class=\"slick-carousel-wrapper\">\n<div class=\"slick-carousel\">\n<div><a href=\"images/carousel/Dianthus_hyssopifolius_ssp_hyssopifolius.jpg\" class=\"lightbox-link\"><img src=\"images/carousel/Dianthus_hyssopifolius_ssp_hyssopifolius.jpg\" alt=\"\"></a><p class=\"img-credit\">© Andrés Romero Bravo</p></div>\n<div><a href=\"images/carousel/Leontodon_nivale_ssp_alpinum.jpg\" class=\"lightbox-link\"><img src=\"images/carousel/Leontodon_nivale_ssp_alpinum.jpg\" alt=\"\"></a><p class=\"img-credit\">© Andrés Romero Bravo</p></div>\n<div><a href=\"images/carousel/Ophrys_speculum.jpg\" class=\"lightbox-link\"><img src=\"images/carousel/Ophrys_speculum.jpg\" alt=\"\"></a><p class=\"img-credit\">© Andrés Romero Bravo</p></div>\n<div><a href=\"images/carousel/Orchis_mascula.jpg\" class=\"lightbox-link\"><img src=\"images/carousel/Orchis_mascula.jpg\" alt=\"\"></a><p class=\"img-credit\">© Andrés Romero Bravo</p></div>\n<div><a href=\"images/carousel/Papaver_orientale.jpg\" class=\"lightbox-link\"><img src=\"images/carousel/Papaver_orientale.jpg\" alt=\"\"></a><p class=\"img-credit\">© Andrés Romero Bravo</p></div>\n<div><a href=\"images/carousel/Pedicularis_sceptrum-carolinum.jpg\" class=\"lightbox-link\"><img src=\"images/carousel/Pedicularis_sceptrum-carolinum.jpg\" alt=\"\"></a><p class=\"img-credit\">© Andrés Romero Bravo</p></div>\n<div><a href=\"images/carousel/Ramonda_myconi.jpg\" class=\"lightbox-link\"><img src=\"images/carousel/Ramonda_myconi.jpg\" alt=\"\"></a><p class=\"img-credit\">© Andrés Romero Bravo</p></div>\n<div><a href=\"images/carousel/Vanessa_atalanta.jpg\" class=\"lightbox-link\"><img src=\"images/carousel/Vanessa_atalanta.jpg\" alt=\"\"></a><p class=\"img-credit\">© Andrés Romero Bravo</p></div>\n</div>\n</div>\n\n```{=html}\n  </div>\n</div>\n</div>\n```\n\n```{=html}\n<div class=\"page-content\">\n<!-- Contact -->\n<div class=\"contact-section\">\n  <h2>Contact</h2>\n  <p>📧 <a href=\"mailto:andres.romero_bravo@biol.lu.se\">andres.romero_bravo@biol.lu.se</a> / <a href=\"mailto:aromerobravo@gmail.com\">aromerobravo@gmail.com</a></p>\n  <p>🏛️ Department of Biology, Lund University<br>\n  Ecologihuset, Kontaktvägen 10, 22362 Lund, Sweden</p>\n</div>\n</div>\n\n<!-- Lightbox overlay -->\n<div id=\"lightbox\" class=\"lightbox-overlay\" onclick=\"this.style.display='none'\">\n  <img id=\"lightbox-img\" src=\"\" alt=\"\">\n</div>\n\n<!-- jQuery and Slick JS -->\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js\"></script>\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.js\"></script>\n<script>\n$(document).ready(function(){\n  var $carousel = $('.slick-carousel');\n  var $slides = $carousel.children('div');\n  var shuffled = $slides.toArray().sort(function(){ return Math.random() - 0.5; });\n  $carousel.empty().append(shuffled);\n  $carousel.slick({\n    centerMode: true,\n    centerPadding: '120px',\n    slidesToShow: 1,\n    autoplay: true,\n    autoplaySpeed: 4000,\n    arrows: false,\n    dots: true,\n    infinite: true,\n    adaptiveHeight: false,\n    initialSlide: 1\n  });\n  // Lightbox\n  $(document).on('click', '.lightbox-link', function(e){\n    e.preventDefault();\n    var src = $(this).attr('href');\n    $('#lightbox-img').attr('src', src);\n    $('#lightbox').fadeIn();\n  });\n});\n</script>\n```\n",
